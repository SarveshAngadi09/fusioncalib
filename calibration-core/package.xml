<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>polycalib_core</name>
  <version>0.1.0</version>
  <description>
    FusionCalib core calibration node. Subscribes to ROS2 sensor topics,
    detects calibration targets, solves extrinsic and intrinsic parameters,
    and manages calibration sessions.
  </description>

  <maintainer email="sarvesh.angadi1997@gmail.com">Sarvesh Angadi</maintainer>
  <license>AGPL-3.0-or-later</license>

  <author email="sarvesh.angadi1997@gmail.com">Sarvesh Angadi</author>
  <url type="website">https://github.com/sarveshangadi/fusioncalib</url>
  <url type="bugtracker">https://github.com/sarveshangadi/fusioncalib/issues</url>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>message_filters</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
