# FusionCalib environment configuration
# Copy this file to .env and adjust for your setup.

# ROS2 domain ID (0-232). Match the ID used by your robot's sensor nodes.
ROS_DOMAIN_ID=0

# ROS2 middleware implementation
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# ROS2 topic names for your camera
RGB_TOPIC=/camera/color/image_raw
DEPTH_TOPIC=/camera/depth/image_rect_raw

# Network ports for the web stack
API_PORT=8000
WEBAPP_PORT=3000
