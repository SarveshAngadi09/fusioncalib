# FusionCalib environment configuration
# Copy this file to .env and adjust for your setup.

# ROS2 domain ID (0-232). Match the ID used by your robot's sensor nodes.
ROS_DOMAIN_ID=0

# ROS2 middleware implementation
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Calibration mode: single (one camera, intrinsics only) or stereo (two cameras)
CALIB_MODE=single

# ROS2 topic names
LEFT_TOPIC=/camera/color/image_raw
RIGHT_TOPIC=/camera2/color/image_raw

# Minimum frames to collect before solve is available
MIN_FRAMES=20

# API port — web UI served at http://localhost:8000
API_PORT=8000
